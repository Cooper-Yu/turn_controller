<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turn_controller</name>
  <version>0.0.0</version>
  <description>Relative in-place yaw PID controller for Task3 maze simulation.</description>
  <maintainer email="liuzi9240@gmail.com">Yu Ge</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ament_index_python</test_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
